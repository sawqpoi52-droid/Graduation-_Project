# SecureCheck Environment Configuration

# Server Port
PORT=5000

# GitHub OAuth App Configuration
# Create OAuth App at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
FRONTEND_URL=http://localhost:5000

# Encryption Key (32-byte hex for AES-256-GCM token encryption)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Session Secret (Optional - defaults to auto-generated fallback)
SESSION_SECRET=

# Database Configuration (Optional - defaults to local SQLite if unset)
# DATABASE_URL=postgresql://user:password@localhost:5432/securecheck

# Email Notification Configuration (Optional - Nodemailer SMTP)
EMAIL_USER=
EMAIL_PASS=
